    {
      "parameters": {
        "jsCode": "const filteredContacts = $(\"Check Filtered Results\").item.json.filteredResults || [];\nconst existingInDB = $input.all().map(i => i.json) || [];\n\nconst existingPlaceIds = new Set(existingInDB.map(c => c.place_id));\n\nconst nouveaux = filteredContacts.filter(c => !existingPlaceIds.has(c.place_id));\nconst existants = filteredContacts.filter(c => existingPlaceIds.has(c.place_id));\n\nreturn [{\n  nouveaux: nouveaux,\n  existants: existants,\n  countNouveaux: nouveaux.length,\n  countExistants: existants.length,\n  countTotal: filteredContacts.length\n}];"
      },
      "id": "56b93d1e-3818-4dad-aa82-86526e814206",
      "name": "Identify New Prospects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.countNouveaux }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a8efe842-d651-465a-bd22-0e5026ca22b9",
      "name": "Check Has New Prospects",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2224,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const nouveaux = $input.first().json.nouveaux || [];\n\nreturn nouveaux.map(contact => {\n  const cleaned = {\n    place_id: contact.place_id,\n    nom: contact.nom,\n    adresse: contact.adresse,\n    code_postal: contact.code_postal,\n    ville: contact.ville,\n    telephone: contact.telephone || contact[\"téléphone\"] || \"\",\n    site_web: contact.site_web || \"\",\n    note_google: contact.note_google || null,\n    activite: contact.activite || contact[\"activité\"] || \"\",\n    statut: \"nouveau_lead\"\n  };\n\n  return { json: cleaned };\n});"
      },
      "id": "44918ae4-775a-4e84-95b1-55ea9e11c21d",
      "name": "Prepare For Insert",

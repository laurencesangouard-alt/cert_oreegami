    {
      "parameters": {
        "jsCode": "const googleResults = $input.first().json.results || [];\nconst webhookData = $('Webhook Recherche').item.json.body || {};\n\nconst activite = webhookData.activite || '';\nconst villeRecherche = webhookData.ville || webhookData.localisation || '';\n\nconst contactsFiltres = googleResults\n  .filter(item => {\n    const hasGoodRating = !item.rating || item.rating >= 3.0;\n    return item.place_id && item.name && item.formatted_address && hasGoodRating;\n  })\n  .slice(0, 5)\n  .map(item => {\n    const codePostalMatch = item.formatted_address.match(/\\b\\d{5}\\b/);\n    const codePostal = codePostalMatch ? codePostalMatch[0] : '';\n\n    return {\n      place_id: item.place_id,\n      nom: item.name,\n      adresse: item.formatted_address,\n      code_postal: codePostal,\n      ville: villeRecherche,\n      telephone: '',\n      site_web: '',\n      note_google: item.rating || null,\n      activite: activite,\n      commercial_id: webhookData.commercial_id || null\n    };\n  });\n\nif (contactsFiltres.length === 0) {\n  return [{\n    success: false,\n    message: `Aucun contact valide trouvé pour \"${activite}\" à \"${villeRecherche}\".`,\n    filteredResults: []\n  }];\n}\n\nreturn [{\n  success: true,\n  filteredResults: contactsFiltres\n}];"
      },
      "id": "f3fbaa63-a932-4ef6-a197-5327b27bf29a",
      "name": "Transform & Filter Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        112
      ]

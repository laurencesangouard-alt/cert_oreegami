        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ \"place_id=in.(\" + $json.filteredResults.map(c => c.place_id).join(\",\") + \")\" }}"
      },
      "id": "177a3596-d7a2-4fc1-834d-65515f0b2a12",
      "name": "Check Existing in Supabase",
      "type": "n8n-nodes-base.supabase",
